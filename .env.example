# Copy to `.env.local` for local development, and set the same variable in
# your hosting provider's environment settings before deploying.
#
# The canonical origin for this site, with protocol and no trailing slash.
# The canonical URL, the sitemap, the structured data and the share-card
# image URL are all built from it.
#
# If this is unset in a production build, the site falls back to
# http://localhost:3000: the build still succeeds, but shared links show a
# broken preview and the sitemap points at a host no crawler can reach. On
# Vercel it resolves itself from VERCEL_PROJECT_PRODUCTION_URL; set it
# explicitly anyway, and always on any other host.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
