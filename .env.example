# Copy to `.env.local` for local development, and set the same variable in
# your hosting provider's environment settings before deploying.
#
# The canonical origin for this site, with protocol and no trailing slash.
# Everything SEO-facing is built from it: canonical URLs, the sitemap,
# JSON-LD @id anchors, the RSS feed, and absolute Open Graph image URLs.
#
# If this is unset in a production build, the site falls back to
# http://localhost:3000 — the build still succeeds, but every shared link
# renders a broken preview and the sitemap points at a host Google cannot
# reach. On Vercel it self-resolves from VERCEL_PROJECT_PRODUCTION_URL, but
# setting it explicitly is still correct and is required on any other host.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
